programa
{
	
	funcao inicio()
	{
	cadeia  Nome, idade, CPF, Data, Sexo, Rua, Bairro, Cidade, Estado, Telefone, Renda, Trabalho
     escreva("Nome?\n")
          leia(Nome)
          escreva("idade?\n")
          leia(idade)
          escreva("CPF?\n")
          leia(CPF)
          escreva("Data?\n")
          leia(Data)
          escreva("Sexo?\n")
          leia(Sexo)
          escreva("Rua?\n")
          leia(Rua)
          escreva("Bairro?\n")
          leia(Bairro)
          escreva("Cidade?\n")
          leia(Cidade)
          escreva("Estado?\n")
          leia(Estado)
          escreva("Telefone?\n")
          leia(Telefone)
          escreva("Renda?\n")
          leia(Renda)
          escreva("Trabalho?\n")
          leia(Trabalho)


          escreva("\n ****** DADOS DO CADASTRO ******")
         
          escreva("\n 1.nome:",Nome)
          
          escreva("\n 2.idade:",idade)
          
          escreva("\n 3.CPF:",CPF)
          
          escreva("\n 4.Data:",Data)
          
          escreva("\n 5.Sexo:",Sexo)
          
          escreva("\n 6.Rua:",Rua)
          
          escreva("\n 7.Bairro:",Bairro)
          
          escreva("\n 8.Cidade:",Cidade)
          
          escreva("\n 9.Estado:",Estado)
          
          escreva("\n 10.Telefone:",Telefone)
          
          escreva("\n 11.Renda:",Renda)
          
          escreva("\n 12.Trabalho:",Trabalho)

          
	}
}
