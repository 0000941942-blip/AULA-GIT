programa
{
	
	funcao inicio()
	{
		cadeia usuario, senha

escreva("Qual é o seu usuário? ")
leia(usuario)

escreva("Qual é a senha? ")
leia(senha)

se ((usuario == "senai") e (senha == "12345"))
{
    escreva("Acesso liberado")
}
senao
{
    escreva("Acesso negado")
}
	}
}
